{
  "name": "excommunicado-continental-protocol",
  "version": "1.0.0",
  "description": "Juego de acción en tercera persona para el navegador inspirado en el universo de John Wick. TypeScript, Three.js y Rapier.",
  "author": "WhySoRichy",
  "license": "MIT",
  "homepage": "https://whysorichy.github.io/excommunicado-continental-protocol/",
  "repository": {
    "type": "git",
    "url": "https://github.com/WhySoRichy/excommunicado-continental-protocol.git"
  },
  "bugs": {
    "url": "https://github.com/WhySoRichy/excommunicado-continental-protocol/issues"
  },
  "keywords": [
    "threejs",
    "rapier",
    "typescript",
    "webgl",
    "game",
    "third-person",
    "vite"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite build && vite preview --open",
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "qa": "npm run build && npm test && npm run test:e2e",
    "media": "npm run build && playwright test -c playwright.media.config.ts && node scripts/make-gif.mjs",
    "poses": "node scripts/poses.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
