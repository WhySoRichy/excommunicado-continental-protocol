{
  "name": "excommunicado-continental-protocol",
  "version": "1.0.0",
  "description": "Juego de acción en tercera persona para el navegador inspirado en el universo de John Wick. TypeScript, Three.js y Rapier.",
  "author": "WhySoRichy",
  "license": "MIT",
  "homepage": "https://whysorichy.github.io/excommunicado-continental-protocol/",
  "repository": {
    "type": "git",
    "url": "https://github.com/WhySoRichy/excommunicado-continental-protocol.git"
  },
  "bugs": {
    "url": "https://github.com/WhySoRichy/excommunicado-continental-protocol/issues"
  },
  "keywords": [
    "threejs",
    "rapier",
    "typescript",
    "webgl",
    "game",
    "third-person",
    "vite"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite build && vite preview --open",
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.server.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "build:qa": "vite build --mode qa --outDir dist-qa",
    "preview:qa": "vite preview --outDir dist-qa --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:qa && playwright test",
    "qa": "npm run build && npm test && npm run test:e2e",
    "media": "npm run build:qa && playwright test -c playwright.media.config.ts && node scripts/make-clip.mjs",
    "poses": "node scripts/poses.mjs",
    "sheets": "node scripts/sheets.mjs",
    "textures": "node scripts/textures.mjs",
    "lint": "oxlint && prettier --check . && knip",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261125.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.10",
    "@types/three": "0.187.0",
    "knip": "6.48.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
